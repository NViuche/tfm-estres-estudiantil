table dwh_nlp_senales
	lineageTag: 04714290-6eb1-5467-96ac-1fbdb93db478

	measure 'LIWC ansiedad (estrés Alto)' = CALCULATE ( DIVIDE ( SUMX ( dwh_nlp_senales, dwh_nlp_senales[liwc_ansiedad_medio] * dwh_nlp_senales[n_posts] ), SUM ( dwh_nlp_senales[n_posts] ) ), vw_dim_nivel_estres[nivel] = "Alto" )
		formatString: 0.00
		displayFolder: 3 Lenguaje
		lineageTag: a2689dff-5b90-5b19-af20-03b2f918b9e8

	measure 'LIWC ansiedad (estrés Bajo)' = CALCULATE ( DIVIDE ( SUMX ( dwh_nlp_senales, dwh_nlp_senales[liwc_ansiedad_medio] * dwh_nlp_senales[n_posts] ), SUM ( dwh_nlp_senales[n_posts] ) ), vw_dim_nivel_estres[nivel] = "Bajo" )
		formatString: 0.00
		displayFolder: 3 Lenguaje
		lineageTag: 164a7926-bdc5-5e0e-a52f-1e1ed1622cc0

	measure 'Ratio discriminante LIWC' = DIVIDE ( [LIWC ansiedad (estrés Alto)], [LIWC ansiedad (estrés Bajo)] )
		formatString: 0.00
		displayFolder: 3 Lenguaje
		lineageTag: eb77abf1-a350-50c0-975c-8c68b87dc47f

	measure 'Sentimiento medio' = DIVIDE ( SUMX ( dwh_nlp_senales, dwh_nlp_senales[sentimiento_medio] * dwh_nlp_senales[n_posts] ), SUM ( dwh_nlp_senales[n_posts] ) )
		formatString: 0.000
		displayFolder: 3 Lenguaje
		lineageTag: bb3ac07b-199d-525a-9e46-dd0b4cbd1a9b

	measure 'Posts analizados' = SUM ( dwh_nlp_senales[n_posts] )
		formatString: #,0
		displayFolder: 3 Lenguaje
		lineageTag: 85f2a645-5ca0-5d61-ba44-4e2fcf9b9a53

