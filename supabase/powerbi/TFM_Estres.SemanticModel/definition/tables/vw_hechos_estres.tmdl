table vw_hechos_estres
	lineageTag: ea53f1bd-207d-5b54-94d3-ba08bd29f0e1

	measure 'Registros (12 fuentes)' = COUNTROWS ( vw_hechos_estres )
		formatString: #,0
		displayFolder: 6 Calidad del dato
		lineageTag: 3c5087b7-0a66-58e8-91d2-dc6c28821d48

	measure '% género informado' = DIVIDE ( CALCULATE ( COUNTROWS ( vw_hechos_estres ), vw_hechos_estres[id_genero] <> 0 ) + 0, COUNTROWS ( vw_hechos_estres ) )
		formatString: 0.0%
		displayFolder: 6 Calidad del dato
		lineageTag: 3d124abd-6670-5cd6-bc85-2552d07bb44d

	measure '% edad informada' = DIVIDE ( CALCULATE ( COUNTROWS ( vw_hechos_estres ), vw_hechos_estres[id_rango_edad] <> 0 ) + 0, COUNTROWS ( vw_hechos_estres ) )
		formatString: 0.0%
		displayFolder: 6 Calidad del dato
		lineageTag: 29e90d5f-8558-54a1-85f4-deb0592ccf6d

	measure '% nivel educativo informado' = DIVIDE ( CALCULATE ( COUNTROWS ( vw_hechos_estres ), vw_hechos_estres[id_nivel_educativo] <> 0 ) + 0, COUNTROWS ( vw_hechos_estres ) )
		formatString: 0.0%
		displayFolder: 6 Calidad del dato
		lineageTag: 69ecf21d-7bca-523c-8301-8b4d2696c701

	measure '% nivel de estrés asignado' = DIVIDE ( CALCULATE ( COUNTROWS ( vw_hechos_estres ), vw_hechos_estres[id_nivel_estres] <> 0 ) + 0, COUNTROWS ( vw_hechos_estres ) )
		formatString: 0.0%
		displayFolder: 6 Calidad del dato
		lineageTag: db99c5e5-50cf-504a-82fd-74b7f4265e9b

	measure Registros = CALCULATE ( COUNTROWS ( vw_hechos_estres ), vw_dim_dataset[uso_modelado] = "incluido" )
		formatString: #,0
		displayFolder: 1 Volumen
		lineageTag: ef064fc1-f62d-5e4a-a79b-f4095add8061

	measure 'Registros estrés Alto' = CALCULATE ( [Registros], vw_dim_nivel_estres[nivel] = "Alto" )
		formatString: #,0
		displayFolder: 1 Volumen
		lineageTag: 8fc51c2e-21ce-50c0-ad9b-dddff40c325b

	measure 'Registros estrés Moderado' = CALCULATE ( [Registros], vw_dim_nivel_estres[nivel] = "Moderado" )
		formatString: #,0
		displayFolder: 1 Volumen
		lineageTag: cff7e176-228c-56cb-a83b-556f125a3af8

	measure 'Registros estrés Bajo' = CALCULATE ( [Registros], vw_dim_nivel_estres[nivel] = "Bajo" )
		formatString: #,0
		displayFolder: 1 Volumen
		lineageTag: 96fd01e7-567f-57e7-bdfb-7282566ccfc0

	measure '% Estrés Alto' = DIVIDE ( [Registros estrés Alto], [Registros] )
		formatString: 0.0%
		displayFolder: 2 Prevalencia
		lineageTag: a8b71dc4-1a46-5d66-a12c-a120eb9d5a3e

	measure '% Estrés Moderado' = DIVIDE ( [Registros estrés Moderado], [Registros] )
		formatString: 0.0%
		displayFolder: 2 Prevalencia
		lineageTag: 61e023f0-0343-5558-9567-0e432069e51e

	measure '% Estrés Bajo' = DIVIDE ( [Registros estrés Bajo], [Registros] )
		formatString: 0.0%
		displayFolder: 2 Prevalencia
		lineageTag: 6aa9c76f-f2da-5574-b313-5bc8e0e5bcc1

	measure '% Estrés Alto global (sin filtros)' = CALCULATE ( [% Estrés Alto], ALL ( vw_dim_genero ), ALL ( vw_dim_rango_edad ), ALL ( vw_dim_nivel_educativo ), ALL ( vw_dim_dataset[bloque] ), ALL ( vw_dim_dataset[dataset] ) )
		formatString: 0.0%
		displayFolder: 2 Prevalencia
		lineageTag: 08579f51-fe1f-5eaf-91c9-c220761a05c3

	measure 'Diferencia vs global (pp)' = ([% Estrés Alto] - [% Estrés Alto global (sin filtros)]) * 100
		formatString: +0.0;-0.0;0.0
		displayFolder: 2 Prevalencia
		lineageTag: 919bc926-a4fa-5875-ab3d-952f5470b24d

	measure 'Cobertura demográfica' = DIVIDE ( CALCULATE ( [Registros], vw_dim_genero[id_genero] <> 0, vw_dim_rango_edad[id_rango_edad] <> 0 ), [Registros] )
		formatString: 0.0%
		displayFolder: 3 Calidad del dato
		lineageTag: 0c145ee4-799d-5838-9306-31a9016e9e29

	measure 'Fuentes en la selección' = CALCULATE ( DISTINCTCOUNT ( vw_hechos_estres[id_dataset] ), vw_dim_dataset[uso_modelado] = "incluido" )
		formatString: 0
		displayFolder: 3 Calidad del dato
		lineageTag: 5f5f9ca9-accc-53d0-a2ba-7888d7c0b797

