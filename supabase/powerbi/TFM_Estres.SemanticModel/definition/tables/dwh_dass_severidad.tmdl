table dwh_dass_severidad
	lineageTag: 71afca35-4897-59cd-999c-e7ee46f57916

	measure 'Ansiedad media DASS (mujeres)' = CALCULATE ( DIVIDE ( SUMX ( dwh_dass_severidad, dwh_dass_severidad[ansiedad_media] * dwh_dass_severidad[n_respondentes] ), SUM ( dwh_dass_severidad[n_respondentes] ) ), vw_dim_genero[id_genero] = 2 )
		formatString: 0.0
		displayFolder: 4 Validación psicológica
		lineageTag: eca9d4f7-76ad-5308-aa95-9326aa90feb4

	measure 'Ansiedad media DASS (hombres)' = CALCULATE ( DIVIDE ( SUMX ( dwh_dass_severidad, dwh_dass_severidad[ansiedad_media] * dwh_dass_severidad[n_respondentes] ), SUM ( dwh_dass_severidad[n_respondentes] ) ), vw_dim_genero[id_genero] = 1 )
		formatString: 0.0
		displayFolder: 4 Validación psicológica
		lineageTag: c5d11279-10ac-5e5a-9e15-c0609c292153

	measure 'Brecha de género en ansiedad (puntos)' = [Ansiedad media DASS (mujeres)] - [Ansiedad media DASS (hombres)]
		formatString: 0.00
		displayFolder: 4 Validación psicológica
		lineageTag: 4237b724-fbda-5dd8-94bb-57354bb75e3b

	measure '% Estrés severo DASS' = DIVIDE ( SUMX ( dwh_dass_severidad, dwh_dass_severidad[pct_estres_severo] * dwh_dass_severidad[n_respondentes] ), SUM ( dwh_dass_severidad[n_respondentes] ) ) / 100
		formatString: 0.0%
		displayFolder: 4 Validación psicológica
		lineageTag: 9a8b3ce1-569f-5c57-9527-b50c33ab91fa

	measure 'Respondentes DASS 18-25' = SUM ( dwh_dass_severidad[n_respondentes] )
		formatString: #,0
		displayFolder: 4 Validación psicológica
		lineageTag: 21874b00-7ab2-5d9b-8641-e3c99e92c36e

