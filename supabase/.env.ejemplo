# Plantilla de credenciales para Supabase. Copia este archivo como .env (en esta
# misma carpeta) y rellena los valores. El .env no se versiona.

# Session pooler: botón "Connect" del proyecto → Connection string → Method: Session pooler
# postgresql://postgres.<ref>:[YOUR-PASSWORD]@aws-0-<región>.pooler.supabase.com:5432/postgres
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
# Con el punto: postgres.<ref del proyecto>
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=

# Usuario de solo lectura que crea migrar_mysql_a_supabase.py (lo usan el Power BI y el prototipo).
# La contraseña la eliges tú; evita los caracteres @ : / # % y las comillas.
SUPABASE_LECTOR_USER=tfm_lector
SUPABASE_LECTOR_PASSWORD=

# API REST para los enlaces de "datos en vivo" del prototipo (publicar_api_lectura.py).
# Project Settings → Data API (URL) y API Keys (clave pública anon / publishable, NUNCA la secret / service_role).
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=

# Origen: MySQL local de XAMPP
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=tfm_estres_estudiantil_2
MYSQL_USER=root
MYSQL_PASSWORD=
