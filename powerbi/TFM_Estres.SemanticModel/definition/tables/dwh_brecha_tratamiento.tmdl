table dwh_brecha_tratamiento
	lineageTag: 060e3d8c-5087-57a6-8ccc-7422e92fc76b

	measure '% Búsqueda de tratamiento' = DIVIDE ( SUM ( dwh_brecha_tratamiento[n_con_tratamiento] ), SUM ( dwh_brecha_tratamiento[n_total] ) )
		formatString: 0.0%
		displayFolder: 4 Validación psicológica
		lineageTag: 80ad5bba-8ad4-58f7-8cf0-9e959a576a17

	measure '% Tratamiento con antecedentes' = CALCULATE ( [% Búsqueda de tratamiento], dwh_brecha_tratamiento[antecedentes_familiares] = "Yes" )
		formatString: 0.0%
		displayFolder: 4 Validación psicológica
		lineageTag: ee185f3f-a4c0-5856-a495-4fdb5c957ea2

	measure '% Tratamiento sin antecedentes' = CALCULATE ( [% Búsqueda de tratamiento], dwh_brecha_tratamiento[antecedentes_familiares] = "No" )
		formatString: 0.0%
		displayFolder: 4 Validación psicológica
		lineageTag: 9e3afb6a-75ae-524b-a501-e5c049be1e09

