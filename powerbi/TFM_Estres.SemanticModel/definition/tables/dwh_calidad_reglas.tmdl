table dwh_calidad_reglas
	lineageTag: 444abbc6-0a36-58cf-b49b-7868615bb989

	measure Reglas = COUNTROWS ( dwh_calidad_reglas )
		formatString: #,0
		displayFolder: Calidad del dato
		lineageTag: 54be2fdc-ca28-506d-88cc-31e24e819adc

	measure 'Reglas OK' = CALCULATE ( [Reglas], dwh_calidad_reglas[estado] = "OK" ) + 0
