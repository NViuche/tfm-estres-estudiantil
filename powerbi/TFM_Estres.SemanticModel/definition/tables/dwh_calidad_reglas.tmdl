		displayFolder: Calidad del dato
		lineageTag: 67396e65-1f31-5260-a23b-b166a098cd38

	measure 'Reglas con aviso' = CALCULATE ( [Reglas], dwh_calidad_reglas[estado] = "AVISO" ) + 0
