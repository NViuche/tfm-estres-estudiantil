table dwh_kpi_resultados
	lineageTag: ae83cba0-ec8c-5b2a-b97c-50aff1ced0b3

	measure 'Última ejecución KPI' = MAX ( dwh_kpi_resultados[fecha_ejecucion] )
		formatString: yyyy-mm-dd hh:nn
		displayFolder: 5 KPIs guardados
		lineageTag: 85f57a37-341d-52a3-8c77-bae0658721d3

	measure 'Valor KPI (última ejecución)' = VAR f = [Última ejecución KPI] RETURN CALCULATE ( MAX ( dwh_kpi_resultados[valor] ), dwh_kpi_resultados[fecha_ejecucion] = f )
		formatString: #,0.00
		displayFolder: 5 KPIs guardados
		lineageTag: f964611e-c952-50c6-baef-97f1ebf5bcb8

